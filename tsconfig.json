{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": ["@cloudflare/workers-types", "node"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true
  },
  "include": ["apps/api/src/**/*.ts", "packages/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules"]
}
